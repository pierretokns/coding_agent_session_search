<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pierretokns.cass-watch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/pierre/.local/bin/cass</string>
        <string>index</string>
        <string>--watch</string>
        <string>--json</string>
        <string>--no-progress-events</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/pierre/consulting/stateofai/cass-fork</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>LowPriorityIO</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>CASS_SKIP_PREFLIGHT_COUNT_TOTAL_MESSAGES</key>
        <string>1</string>
        <key>FSQLITE_PAGE_BUFFER_MAX</key>
        <string>8192</string>
        <key>CASS_DOCTOR_FAST_SOURCE_INVENTORY</key>
        <string>1</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/cass-watch.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/cass-watch.launchd.err.log</string>
</dict>
</plist>
